# Required in production. Passwords must be at least 16 characters.
ADMIN_USER=replace-me
ADMIN_PASS=replace-with-a-long-random-password

# Disabled by default because the SQLite file contains routes and client IPs.
ENABLE_DB_DOWNLOAD=false

# Resolves stored addresses to a city via ipapi.co, a third party. Off by
# default: leaving it off means no visitor address is sent anywhere.
ENABLE_GEOIP=false

# Set to 1 only when deployed behind exactly one trusted proxy (such as Fly.io).
# Leave unset when clients connect directly, or X-Forwarded-For can be spoofed.
# TRUST_PROXY_HOPS=1

# Per-client limits over 15 minutes.
UPLOAD_RATE_LIMIT=20
PROXY_RATE_LIMIT=120
TILE_RATE_LIMIT=600
ADMIN_RATE_LIMIT=60

# Upstream response limits.
OVERPASS_MAX_RESPONSE_BYTES=8388608
TILE_MAX_RESPONSE_BYTES=2097152

# Stop accepting uploads once the SQLite file reaches this size (bytes).
# Keeps an anonymous endpoint from filling the volume. Default 512 MB.
MAX_ROUTE_DB_BYTES=536870912

# Overpass response cache. OSM data for a bbox moves on the order of days, so
# caching keeps repeat route loads off the public endpoint.
OVERPASS_CACHE_TTL_MS=21600000
OVERPASS_CACHE_MAX_ENTRIES=200
OVERPASS_CACHE_MAX_BYTES=67108864

# Per-operation SQLite tracing. Useful when a volume misbehaves, noise otherwise.
DEBUG_DB=false
